{
  "id": "org.rubygtkproject.Biblioteca",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51beta",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": ["org.gnome.Sdk.Docs"],
  "command": "biblioteca",
  "separate-locales": false,
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/man",
    "#/share/doc",
    "/share/gtk-doc",
    "/share/man",
    "/share/pkgconfig",
    "/share/installed-tests",
    "*.la",
    "*.a"
  ],
  "modules": [
    "modules/gom.json",
    "modules/jsonrpc-glib.json",
    "modules/libshumate.json",
    "modules/libspelling.json",
    "modules/vte.json",
    "modules/sdk-docs.json",
    {
      "name": "Biblioteca",
      "buildsystem": "simple",
      "build-commands": [
        "gem build biblioteca-rb.gemspec",
        "gem install --local --no-document --install-dir /app/lib/biblioteca-rb --bindir /app/bin biblioteca-rb-*.gem",
        "env PREFIX=/app rake data:install"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".."
        }
      ]
    }
  ]
}
